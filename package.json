{
  "name": "graph_starz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check-syntax": "cross-env DEBUG=app:syntax node scripts/check-syntax.js",
    "dev": "yarn check-syntax && cross-env DEBUG=app:* rimraf .next && cross-env DEBUG=app:* next dev",
    "dev:nocache": "next dev",
    "clean:dev": "rimraf .next && next dev",
    "clean:dev:debug": "cross-env DEBUG=app:* rimraf .next && cross-env DEBUG=app:* next dev",
    "build": "yarn check-syntax && next build",
    "build:prod": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init:clear": "cross-env DEBUG=db:init:* GCS_BUCKET_NAME=starz-439218.firebasestorage.app GOOGLE_APPLICATION_CREDENTIALS_PATH=./gcs-credentials.json FORCE_RESET=true CLEAR_DATA=true node src/lib/neo4j/init-db.js",
    "db:init:prod:clear": "cross-env GOOGLE_APPLICATION_CREDENTIALS_PATH=./gcs-credentials.json GCS_BUCKET_NAME=starz-prod NODE_ENV=production FORCE_RESET=true CLEAR_DATA=true DEBUG=db:init:* node src/lib/neo4j/init-db.js",
    "test": "cross-env NODE_ENV=test DEBUG=jest:* jest --colors=false --verbose --no-cache",
    "test:watch": "cross-env NODE_ENV=test jest --watch --colors=false --verbose=false --silent",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --colors=false --verbose=false --silent --coverageReporters='text-summary'",
    "validate-secrets": "cross-env DEBUG=app:* node scripts/validate-secrets.js development",
    "validate-secrets:prod": "cross-env DEBUG=app:* GOOGLE_APPLICATION_CREDENTIALS_PATH=./gcs-credentials.json node scripts/validate-secrets.js production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@auth/core": "^0.37.4",
    "@google-cloud/storage": "^7.14.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "debug": "^4.4.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.0",
    "neo4j-driver": "^5.27.0",
    "next": "15.0.3",
    "next-auth": "^4.24.10",
    "node-fetch": "^3.3.2",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-error-boundary": "^5.0.0",
    "sharp": "^0.33.2",
    "sharp-phash": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-env": "^7.26.7",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "20.12.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-jest": "^29.7.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fixed-jsdom": "^0.0.9",
    "jsdom": "22.1.0",
    "postcss": "^8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
