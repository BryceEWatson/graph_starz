{
  "name": "graph_starz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DEBUG=app:* rimraf .next && cross-env DEBUG=app:* next dev",
    "dev:nocache": "next dev",
    "clean:dev": "rimraf .next && next dev",
    "clean:dev:debug": "cross-env DEBUG=app:* rimraf .next && cross-env DEBUG=app:* next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "cross-env DEBUG=db:init:* node src/lib/neo4j/init-db.js",
    "db:init:force": "cross-env DEBUG=db:init:* FORCE_RESET=true node src/lib/neo4j/init-db.js",
    "db:init:clear": "cross-env DEBUG=db:init:* FORCE_RESET=true CLEAR_DATA=true node src/lib/neo4j/init-db.js",
    "db:init:prod": "cross-env GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json NODE_ENV=production DEBUG=db:init:* node src/lib/neo4j/init-db.js",
    "db:init:prod:force": "cross-env GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json NODE_ENV=production FORCE_RESET=true DEBUG=db:init:* node src/lib/neo4j/init-db.js",
    "db:init:prod:clear": "cross-env FORCE_RESET=\"true\" CLEAR_DATA=\"true\" NODE_ENV=\"production\" GOOGLE_APPLICATION_CREDENTIALS=\"./gcs-credentials.json\" DEBUG=\"db:init:*\" node src/lib/neo4j/init-db.js",
    "test": "jest --colors=false --verbose=false --silent | node scripts/clean-output.js",
    "test:watch": "jest --watch --colors=false --verbose=false --silent",
    "test:coverage": "jest --coverage --colors=false --verbose=false --silent --coverageReporters='text-summary'",
    "validate-secrets": "cross-env DEBUG=app:* node scripts/validate-secrets.js development",
    "validate-secrets:prod": "cross-env DEBUG=app:* GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json node scripts/validate-secrets.js production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@auth/core": "^0.37.4",
    "@google-cloud/storage": "^7.14.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "debug": "^4.3.7",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.0",
    "neo4j-driver": "^5.27.0",
    "next": "15.0.3",
    "next-auth": "^4.24.10",
    "node-fetch": "^3.3.2",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "sharp": "^0.33.2",
    "sharp-phash": "^2.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
