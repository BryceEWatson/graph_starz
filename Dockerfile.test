FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile --production=false

# Copy source
COPY . .

# Create test environment file
RUN echo "NODE_ENV=test" > .env && \
    echo "NEXT_TELEMETRY_DISABLED=1" >> .env && \
    echo "GOOGLE_CLIENT_ID=test" >> .env && \
    echo "GOOGLE_CLIENT_SECRET=test" >> .env && \
    echo "NEO4J_URI=test" >> .env && \
    echo "NEO4J_USER=test" >> .env && \
    echo "NEO4J_PASSWORD=test" >> .env && \
    echo "ANTHROPIC_API_KEY=test" >> .env && \
    echo "GCS_BUCKET_NAME=test" >> .env && \
    echo "FRONTEND_URL=http://localhost:3000" >> .env && \
    echo "NEXTAUTH_SECRET=test" >> .env

# Build application
RUN yarn build

# Expose port
EXPOSE 3000

# Start application
CMD ["yarn", "start"]
