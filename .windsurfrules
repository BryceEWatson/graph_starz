name: Graph Starz LLM Coding Guidelines
description: Concise coding guidelines for LLM code generation.
version: 1.5.2
last_updated: "2025-01-11"

general_principles:
  description: Core JS/Node.js principles.
  rules:
    - id: FullFileRead
      description: Always read the *entire file* before changes.
      how_to: Do not assume from partial code; read the full file.
    - id: KISS
      description: Keep code simple.
      how_to: Use simplest logic; break down complex logic.
    - id: POLA
      description: Follow common JS/Node.js conventions.
      how_to: Use idiomatic style (camelCase, PascalCase).
    - id: SRP
      description: Each function/module has one job.
      how_to: Separate concerns.
    - id: DRY
      description: Avoid repeating code.
      how_to: Use shared functions.
    - id: FailFast
      description: Report errors early.
      how_to: Exit immediately on critical errors.
    - id: ValidateEnv
      description: Validate env variables at startup.
      how_to: Check type/format; error if absent.

testing:
  description: TDD rules.
  rules:
    - id: TestFirst
      description: Write tests before code.
      how_to: Define test cases (normal, edge, error) first.
    - id: TestImpl
      description: Minimal code to pass tests.
      how_to: Write only necessary code.
    - id: TestFiles
      description: Test files in `__tests__`; use `.test.js`.
      how_to: Mocks in `__mocks__`.
    - id: JestMocking
      description: Use Jest mocking; reuse mocks.
      how_to: Use `d3Mock.js` for d3; ensure chaining.

code_style:
  description: Code formatting.
  rules:
    - id: UseClient
      description: Add 'use client' in NextJS client components.
      how_to: Start client components with `use client`.
    - id: NoSemicolons
      description: Avoid trailing semicolons.
      how_to: Omit unless required.
    - id: LFLineEndings
      description: Use LF line endings.
      how_to: Ensure LF, not CRLF.
    - id: NoSpecialChars
      description: Avoid special chars/emojis.
      how_to: Do not use special characters.

error_handling:
  description: Error handling.
  rules:
      - id: TryCatch
        description: Use try-catch for errors.
        how_to: Wrap code; log; recover/rethrow.
      - id: DetailedErrors
        description: Detailed error messages.
        how_to: Include type, message, stack.
      - id: HTTPCodes
        description: Use specific HTTP codes.
        codes:
          401: Auth
          409: Conflicts
          400: Invalid
          500: Server
      - id: PowerErrors
        description: PowerShell error format.
        how_to: Use "Error $_"; use string concat.

deployment:
  description: Deployment rules.
  rules:
    - id: EnvChecks
      description: Verify environment.
      how_to: Verify tools, env, connectivity.
    - id: NoSilentFailures
      description: Do not continue if prerequisites are not met.
      how_to: Validate steps; exit on failure.
    - id: WindowsPowershell
      description: PowerShell compatibility.
      how_to: Use PowerShell; `\` for paths.

documentation:
  description: Documentation rules.
  rules:
    - id: NoHypothetical
      description: Accurate documentation.
      how_to: Docs must reflect current code.
    - id: FeatureCodeAlign
      description: Feature files match code.
      how_to: Feature files must match implementation.

feature_integration:
  description: Feature integration rules.
  rules:
      - id: APIConsistency
        description: Consistent APIs/data.
        how_to: Follow existing API patterns.
      - id: ComponentDeps
        description: Update tests for component changes.
        how_to: Map affected components; ensure tests.
      - id: SystemArch
        description: Follow arch patterns.
        how_to: Follow existing arch; maintain separation.
      - id: DataConsistency
        description: Consistent data.
        how_to: Document schemas; validate data.

research_questions:
  description: How to ask research questions.
  rules:
    - id: WhenAsk
      description: Ask when unsure/complex.
      how_to: Do not assume; ask when unclear.
    - id: Format
      description: Specific questions with code.
      how_to: Include problem, code, what you tried.

code_review:
    description: Code review rules
    rules:
      - id: FeatureReview
        description: Review features, tests, API.
        how_to: Check feature, duplicate logic, API, tests.
      - id: ArchitectureReview
        description: Review arch, scalability, security.
        how_to: Check arch, scalability, security, component interaction.

workflow:
  description: Development steps.
  steps:
    - Write tests first.
    - Document decisions.
    - Research solutions.
    - Code reviews.
    - Verify BDD.
    - Update docs.

feature_verification:
  description: Code-feature alignment.
  steps:
    - Review feature scenarios.
    - Locate implementations.
    - Compare with code.
    - Run tests.
    - Document gaps.
    - Remove hypothetical.
    - Update status.

test_driven_development:
  description: TDD guidelines.
  test_case_coverage:
    - Expected behavior.
    - Edge cases.
    - Error handling.
  workflow:
    - Write tests.
    - Write code to pass.
    - Refactor with passing tests.
    - Run all tests.
  documentation:
    - Document tests.

research_process:
  description: Tracking research.
  gap_identification:
    scenario:
      - Document code/behavior.
      - Note system state.
      - Identify patterns.
  research_questions:
    format:
      - Clear problem.
      - Current attempts.
      - Specific questions.
      - Code/errors.
    tracking:
      - Add to "c:/Users/Bryce/Documents/Projects/graph_starz/Documentation/research_questions.md".
  solution_handling:
    - Share solutions.