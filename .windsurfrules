development_guidelines:
  description: Essential development practices and standards
  code_quality:
    error_handling:
      description: Guidelines for robust error management
      rules:
        - Use specific try-catch blocks for known error types
        - Implement consistent error response format
        - Include appropriate HTTP status codes
        - Log errors with context (timestamp, type, stack trace)
        - Clean up resources on error
        - Follow language-specific error guidelines
        - Ensure errors are properly logged to Cloud Logging
        - Include component-specific error context
        - Implement proper error recovery mechanisms
        - Use standardized error response structure

    initialization_guidelines:
      description: Standards for application initialization
      rules:
        - Component verification:
          - Test all external service connections
          - Verify database indices and schema
          - Check API key access and permissions
        - Status reporting:
          - Report detailed status for each component
          - Include success/failure indicators
          - Provide error context when needed
        - Error recovery:
          - Make initialization idempotent
          - Allow safe retries
          - Clean up partial initializations
        - Monitoring:
          - Log initialization status
          - Track initialization metrics
          - Alert on initialization failures

    powershell_guidelines:
      description: PowerShell-specific coding standards
      rules:
        - Error message formatting:
          - Do not add colons before error variables (e.g., use "Error $_" not "Error: $_")
          - Use string concatenation for error messages (e.g., "Failed to test $endpoint $_")
        - Variable expansion:
          - Use double quotes for variable expansion
          - Test all error message outputs before committing
        - Error handling:
          - Always capture and display the full error object ($_)
          - Use -ErrorAction Stop for critical operations
        - Output formatting:
          - Keep error messages concise and clear
          - Use Write-ColorOutput for consistent styling
        - YAML handling:
          - Use [System.IO.File]::WriteAllText() for YAML files to prevent BOM and encoding issues
          - Validate YAML structure after string replacements
          - Be cautious with variable expansion in YAML content

    cloud_run_guidelines:
      description: Standards for Cloud Run deployments
      secret_management:
        - Secret reference format:
          - Use 'name' field with simple secret names (e.g., "NEXTAUTH_SECRET")
          - Avoid full project paths in secret names
          - Only use alphanumeric characters, hyphens, or underscores
        - Version handling:
          - Use 'key' field instead of 'version'
          - Prefer specific versions over "latest" for stability
        - Project context:
          - Cloud Run automatically finds secrets in same project
          - No need to specify project paths
        - Validation:
          - Verify secret access before deployment
          - Check secret reference format in YAML
          - Test with specific versions before using "latest"
        - Error handling:
          - Log deployment errors with context
          - Maintain zero-downtime during updates
          - Preserve previous version as backup
          - Clean up old images after verification

    modularity:
      description: Guidelines for maintainable code structure
      principles:
        - Single responsibility per component
        - Separation of concerns
        - Modularity and testability

    change_management:
      description: Guidelines for making and documenting code changes
      rules:
        - Always explain changes clearly before implementing them
        - List all files being modified and why
        - Describe the purpose of each significant change
        - Document any new dependencies or configuration requirements
        - Explain how changes affect the initialization flow
        - Test changes thoroughly before committing
        - Update documentation to reflect changes
        - When changing configuration or secrets:
          - Document the source of each configuration value
          - Explain how values are passed between components
          - Verify changes in both development and production contexts
        - When modifying deployment scripts:
          - Test with all required credentials and configurations
          - Verify changes in a clean environment
          - Document any new environment requirements

